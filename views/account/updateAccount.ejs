


<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<h1>Update Account</h1>

 <div class="form">
    
        <form action="/account/update" method="post">
          
                <div class="flex">
                    <p>Firstname*</p>
                <label><input type="text" name="account_firstname" value="<%- data.account_firstname %>"></label>
                
                <p>Lastname*</p>
                <label><input type="text" name="account_lastname" title="account_lastname" autocomplete="family-name" required></label>
                <p>Email*</p>
                <label><input type="email" name="account_email" title="account_email" autocomplete="email" required ></label>
              
            
                <input type="submit" value="register" class="submitButton">
                
                </form>

                <form action="">
                      <p>Password*</p>
                <label><input type="password" name="account_password" title="account_password" pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$" required></label>
                <span>Passwords must be at least 12 characters and contain at least 1 number, 1 capital letter and 1 special character</span> 

                </form>
            </div>